# ============================================================
# Cognia 配置模板
# 使用方法：复制本文件为 backend/.env，然后填入你的 API Key
# 未配置 API Key 时，Cognia 自动使用内置「离线诊断模式」，仍可完整运行闭环
# ============================================================

# --- AI 引擎（OpenAI 兼容协议） ---
# 填入任意 OpenAI 兼容服务的 Key 即可启用 AI 引擎
OPENAI_API_KEY=

# API Base URL：
#   OpenAI 默认：https://api.openai.com/v1
#   DeepSeek：    https://api.deepseek.com/v1
#   Ollama 本地： http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名（需与所选服务匹配）
OPENAI_MODEL=gpt-4o-mini

# --- 服务 ---
COGNIA_HOST=0.0.0.0
COGNIA_PORT=8000
