# ============================================================
# Cognia 配置模板
#
# 默认已对齐本机 TencentDB Agent Memory 的 LLM 接入方式：
#   走宿主机 127.0.0.1:8090 的 adapter.py（OpenAI 兼容代理）
#   → 转发到工蜂 Copilot Gateway
# 无需任何配置即可启用 AI 引擎。
# 如需强制「离线诊断模式」，设 COGNIA_AI_ENABLED=0。
#
# 使用方法：如需覆盖默认值，复制本文件为 backend/.env 后修改。
# ============================================================

# --- AI 引擎（OpenAI 兼容协议） ---
# 本机 adapter 的 base_url。
# 与 memory hub 的唯一区别：memory hub 在容器里用 host.docker.internal，
# Cognia 在宿主机直接用 127.0.0.1。
OPENAI_BASE_URL=http://127.0.0.1:8090/v1

# adapter 不校验 Bearer，任意非空值即可（memory hub 也用 tdai-key）。
OPENAI_API_KEY=tdai-key

# model 默认用 fast 模型（adapter 白名单直通，不会被轮换覆盖）。
OPENAI_MODEL=deepseek-v4-flash

# 主模型失败时回退的备选 fast 模型（直通模型失败不会自动轮换，靠这里兜底）。
OPENAI_MODEL_FALLBACK=glm-5-3-flash-internal

# 1=启用 AI 引擎（默认），0=强制离线诊断模式。
COGNIA_AI_ENABLED=1

# --- 服务 ---
COGNIA_HOST=0.0.0.0
COGNIA_PORT=8000
