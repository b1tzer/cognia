# ===== LLM 接入（本地 OpenAI 兼容 adapter）=====
# 本地 adapter 把标准 OpenAI 请求转发到工蜂 Copilot Gateway
# （/opt/tdai/adapter/adapter.py，监听 127.0.0.1:8090）
# 客户端鉴权 key = adapter 进程的 ADAPTER_API_KEY（未配置则放行）
LLM_API_BASE=http://127.0.0.1:8090/v1
LLM_API_KEY=

# ===== Chainlit 登录认证（本地教学环境固定账号）=====
# 用于关联历史对话归属 + 支持刷新恢复；未配置时回退 admin/admin
CHAINLIT_AUTH_USERNAME=admin
CHAINLIT_AUTH_PASSWORD=admin
# 生产环境务必替换为随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAINLIT_AUTH_SECRET=change-me-to-a-random-secret

# ===== 模型 ID =====
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役
PLANNER_MODEL=deepseek-v4-flash
DIAGNOSER_MODEL=deepseek-v4-flash
TEACHER_MODEL=deepseek-v4-flash

# ===== 数据库（Supabase 托管 Postgres，含 pgvector）=====
# 短期记忆 Checkpointer + 长期记忆 Store 共用
LANGGRAPH_DATABASE_URL=postgresql://postgres:password@localhost:5432/cognia

# ===== 可观测（Langfuse 开源，可选）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
