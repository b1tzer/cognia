# ===== DeepSeek =====
# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-xxx

# ===== 模型 ID =====
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役
PLANNER_MODEL=deepseek-v4-flash
DIAGNOSER_MODEL=deepseek-v4-pro
TEACHER_MODEL=deepseek-v4-flash

# ===== 数据库（Supabase 托管 Postgres，含 pgvector）=====
# 短期记忆 Checkpointer + 长期记忆 Store 共用
DATABASE_URL=postgresql://postgres:password@localhost:5432/cognia

# ===== 可观测（Langfuse 开源，可选）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
